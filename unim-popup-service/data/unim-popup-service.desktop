[Desktop Entry]
Name=UNIM Popup Service
Name[ko]=UNIM 팝업 서비스
Comment=Korean Input Method popup service (hanja / special-char / emoji)
Comment[ko]=한글 입력기 팝업 서비스 (한자 / 특수문자 / 이모지)
Exec=unim-popup-service
Icon=unim-korean
Terminal=false
Type=Application
Categories=System;Utility;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Phase=Applications
X-GNOME-AutoRestart=true
X-GNOME-UsesNotifications=true
StartupNotify=false
NoDisplay=true
