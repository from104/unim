[Desktop Entry]
Name=UNIM Popup Service
Name[ko]=UNIM 팝업 서비스
Comment=Korean Input Method popup & tray service
Comment[ko]=한글 입력기 팝업·트레이 서비스
Exec=unim-popup-service
Icon=unim-korean
Terminal=false
Type=Application
Categories=System;Utility;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Phase=Applications
X-GNOME-AutoRestart=true
X-GNOME-UsesNotifications=true
StartupNotify=false
NoDisplay=true
NotShowIn=GNOME;
