#: prefs.js:91
msgid "Conversion Shortcut"
msgstr "변환 단축키"

#: prefs.js:92
msgid "Shortcut key string (e.g., \"<Super>k\")"
msgstr "단축키 문자열 (예: \"<Super>k\")"

#: prefs.js:118
msgid "Auto Paste"
msgstr "자동 붙여넣기"

#: prefs.js:119
msgid "Automatically paste converted text after copying to clipboard"
msgstr "클립보드에 복사된 후 변환된 텍스트를 자동으로 붙여넣습니다"
