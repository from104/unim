#: extension.js:133
msgid "UNIM Autocorrect"
msgstr "UNIM 한영 자동 변환"

#: extension.js:133
#, javascript-format
msgid "Conversion complete: %s"
msgstr "변환 완료: %s"

#: prefs.js:14
msgid "General Settings"
msgstr "일반 설정"

#: prefs.js:15
msgid "Basic configuration for the extension"
msgstr "확장의 기본 구성을 설정합니다"

#: prefs.js:24
msgid "Enable Extension"
msgstr "확장 활성화"

#: prefs.js:25
msgid "Turn the extension functionality on or off"
msgstr "확장 기능을 켜거나 끕니다"

#: prefs.js:34
msgid "Show Notifications"
msgstr "알림 표시"

#: prefs.js:35
msgid "Show a notification when text is converted"
msgstr "텍스트가 변환될 때 알림을 표시합니다"

#: prefs.js:41
msgid "Keyboard Layouts"
msgstr "키보드 레이아웃"

#: prefs.js:42
msgid "Select your keyboard layouts for accurate conversion"
msgstr "정확한 변환을 위해 키보드 레이아웃을 선택하세요"

#: prefs.js:50
msgid "Korean Layout"
msgstr "한글 자판"

#: prefs.js:51
msgid "Select the Korean keyboard layout"
msgstr "사용할 한글 자판을 선택하세요"

#: prefs.js:53
msgid "2-Set Standard (두벌식 표준)"
msgstr "두벌식 표준"

#: prefs.js:54
msgid "3-Set 390 (세벌식 390)"
msgstr "세벌식 390"

#: prefs.js:55
msgid "3-Set 391 (세벌식 391/최종)"
msgstr "세벌식 391/최종"

#: prefs.js:63
msgid "English Layout"
msgstr "영문 자판"

#: prefs.js:64
msgid "Select the English keyboard layout"
msgstr "사용할 영문 자판을 선택하세요"

#: prefs.js:67
msgid "QWERTY"
msgstr "쿼티 (QWERTY)"

#: prefs.js:68
msgid "Dvorak"
msgstr "드보락 (Dvorak)"

#: prefs.js:75
msgid "Manual Conversion"
msgstr "수동 변환"

#: prefs.js:76
msgid "Shortcuts for manual text conversion"
