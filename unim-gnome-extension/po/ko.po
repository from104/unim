#: extension.js:133
msgid "UNIM TypeFIX"
msgstr "UNIM TypeFIX (한영 자동 변환)"

#: extension.js:133
#, javascript-format
msgid "Conversion complete: %s"
msgstr "변환 완료: %s"

#: prefs.js:14
msgid "General Settings"
msgstr "일반 설정"

#: prefs.js:15
msgid "Basic configuration for the extension"
msgstr "확장의 기본 구성을 설정합니다"

#: prefs.js:24
msgid "Enable Extension"
msgstr "확장 활성화"

#: prefs.js:25
msgid "Turn the extension functionality on or off"
msgstr "확장 기능을 켜거나 끕니다"

#: prefs.js:34
msgid "Show Notifications"
msgstr "알림 표시"

#: prefs.js:35
msgid "Show a notification when text is converted"
msgstr "텍스트가 변환될 때 알림을 표시합니다"

#: prefs.js:41
msgid "Keyboard Layouts"
msgstr "키보드 레이아웃"

#: prefs.js:42
msgid "Select your keyboard layouts for accurate conversion"
msgstr "정확한 변환을 위해 키보드 레이아웃을 선택하세요"

#: prefs.js:50
msgid "Korean Layout"
msgstr "한글 자판"

#: prefs.js:51
msgid "Select the Korean keyboard layout"
msgstr "사용할 한글 자판을 선택하세요"

#: prefs.js:53
msgid "2-Set Standard (두벌식 표준)"
msgstr "두벌식 표준"

#: prefs.js:54
msgid "3-Set 390 (세벌식 390)"
msgstr "세벌식 390"

#: prefs.js:55
msgid "3-Set 391 (세벌식 391/최종)"
msgstr "세벌식 391/최종"

#: prefs.js:63
msgid "English Layout"
msgstr "영문 자판"

#: prefs.js:64
msgid "Select the English keyboard layout"
msgstr "사용할 영문 자판을 선택하세요"

#: prefs.js:67
msgid "QWERTY"
msgstr "쿼티 (QWERTY)"

#: prefs.js:68
msgid "Dvorak"
msgstr "드보락 (Dvorak)"

#: prefs.js:75
msgid "Keyboard Shortcuts"
msgstr "키보드 단축키"

#: prefs.js:76
msgid "Current keybindings for various conversion modes. These can be configured in the GNOME Settings or Extension Manager."
msgstr "다양한 변환 모드에 대한 현재 단축키 설정입니다. 설정 앱이나 확장 프로그램 관리자에서 변경할 수 있습니다."

#: prefs.js:84
msgid "English → Korean"
msgstr "영어 → 한국어"

#: prefs.js:85
msgid "Converts English typed with Korean layout and pastes it."
msgstr "한국어 키보드 배열로 입력한 영어를 한국어로 변환하여 붙여넣습니다."

#: prefs.js:91
msgid "Korean → English"
msgstr "한국어 → 영어"

#: prefs.js:92
msgid "Converts Korean typed with English layout and pastes it."
msgstr "영어 키보드 배열로 입력한 한국어를 영어로 변환하여 붙여넣습니다."

#: prefs.js:98
msgid "Terminal (E → K)"
msgstr "터미널 (영 → 한)"

#: prefs.js:99
#: prefs.js:106
msgid "Converts with backspaces before pasting, suitable for terminals."
msgstr "붙여넣기 전에 기존 글자를 백스페이스로 지웁니다. 터미널 환경에 적합합니다."

#: prefs.js:105
msgid "Terminal (K → E)"
msgstr "터미널 (한 → 영)"

#: prefs.js:112
msgid "Copy Only (E → K)"
msgstr "복사 전용 (영 → 한)"

#: prefs.js:113
#: prefs.js:120
msgid "Converts and copies to clipboard without pasting."
msgstr "문자를 변환하여 클립보드에 복사만 하고 붙여넣지는 않습니다."

#: prefs.js:119
msgid "Copy Only (K → E)"
msgstr "복사 전용 (한 → 영)"

#: prefs.js:118
msgid "Auto Paste"
msgstr "자동 붙여넣기"

#: prefs.js:122
msgid "Reset to default"
msgstr "기본값으로 초기화"

