  "rule_sets": {
    "sun_arae_batchim": {
      "active": false,
      "description": "받침을 8개(ㄱㄴㄹㅁㅂㅅㅇㅎ)만 쓰는 단순화된 자판과 함께 쓸 때 켭니다. ㄴ+ㄴ→ㄷ, ㄱ+ㅎ→ㅋ처럼 두 키 조합으로 겹받침과 거센소리 받침을 만듭니다. 순아래 자판은 받침이 직접 배치되어 있어 기본은 꺼져 있지만, 단순 자판 호환이 필요할 때 켤 수 있습니다.",
      "combinations": [
        { "first": "ᆫ", "second": "ᆫ", "result": "ᆮ" },
        { "first": "ᆫ", "second": "ᆺ", "result": "ᆽ" },
        { "first": "ᆨ", "second": "ᇂ", "result": "ᆿ" },
        { "first": "ᆸ", "second": "ᇂ", "result": "ᇁ" },
        { "first": "ᆮ", "second": "ᇂ", "result": "ᇀ" },
        { "first": "ᆽ", "second": "ᇂ", "result": "ᆾ" },
        { "first": "ᆭ", "second": "ᆺ", "result": "ᆬ" },
        { "first": "ᆶ", "second": "ᆫ", "result": "ᆴ" },
        { "first": "ᆶ", "second": "ᆸ", "result": "ᆵ" }
      ]
    }
