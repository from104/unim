      { "first": "ㄷ", "second": "ㄷ", "result": "ㄸ" },
      { "first": "ㅂ", "second": "ㅂ", "result": "ㅃ" },
      { "first": "ㅅ", "second": "ㅅ", "result": "ㅆ" },
      { "first": "ㅈ", "second": "ㅈ", "result": "ㅉ" }
    ],
