{
  "schema_version": 2,
  "language": "korean",
  "name": "3bul_noshift",
  "type": "3bul",
  "metadata": {
    "display_name": "세벌식 순아래",
    "description": "Shift 키를 거의 누르지 않도록 종성을 위쪽 숫자열까지 펼쳐 둔 세벌식 변종. 한 손 입력이나 손목 부담이 큰 사용자에게 적합.",
    "version": "1.0",
    "tags": ["korean", "3bul", "accessibility", "noshift"]
  },
  "layout": {
    "upper": {
      "1st": ["~", "!", "@", "#", "$", "%", "^", "&", "*", "(", ")", "_", "+", "|"],
      "2nd": ["", "", "", "", ";", "<", "7", "8", "9", ">", "{", "}"],
      "3nd": ["", "[", "]", "", "/", "'", "4", "5", "6", ":", "\""],
      "4th": ["-", "=", "\\", "", "!", "0", "1", "2", "3", "?"]
    },
    "lower": {
      "1st": ["`", "ᇂ", "ᆻ", "ᆸ", "ㅛ", "ㅠ", "ㅑ", "ㅖ", "ㅢ", "ㅋ", "ㅒ", "ᆽ", "ᆾ", "ᆿ"],
      "2nd": ["ᆺ", "ᆯ", "ㅕ", "ㅐ", "ㅓ", "ㄹ", "ㄷ", "ㅁ", "ㅊ", "ㅍ", "ᇀ", "ᇁ"],
      "3nd": ["ᆼ", "ᆫ", "ㅣ", "ㅏ", "ㅡ", "ㄴ", "ㅇ", "ㄱ", "ㅈ", "ㅂ", "ㅌ"],
      "4th": ["ᆷ", "ᆨ", "ㅔ", "ㅗ", "ㅜ", "ㅅ", "ㅎ", ",", ".", "ᆮ"]
    }
  },
  "combinations": {
