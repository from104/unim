  "metadata": {
    "display_name": "Colemak",
    "author": "Shai Coleman (2006)",
    "description": "QWERTY와 비슷한 위치에 Z·X·C·V를 두어 단축키는 그대로 쓰면서 손가락 부담은 줄인 현대식 영문 자판. 2006년 발표.",
    "version": "1.0",
    "tags": ["english", "alt"]
  },
  "layout": {
    "upper": {
      "1st": ["~", "!", "@", "#", "$", "%", "^", "&", "*", "(", ")", "_", "+", "|"],
      "2nd": ["Q", "W", "F", "P", "G", "J", "L", "U", "Y", ":", "{", " }"],
      "3rd": ["A", "R", "S", "T", "D", "H", "N", "E", "I", "O", "\""],
      "4th": ["Z", "X", "C", "V", "B", "K", "M", "<", ">", "?"]
    },
    "lower": {
      "1st": ["`", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "-", "=", "\\"],
      "2nd": ["q", "w", "f", "p", "g", "j", "l", "u", "y", ";", "[", "]"],
      "3rd": ["a", "r", "s", "t", "d", "h", "n", "e", "i", "o", "'"],
      "4th": ["z", "x", "c", "v", "b", "k", "m", ",", ".", "/"]
    }
  }
}
