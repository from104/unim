{
  "schema_version": 1,
  "language": "english",
  "name": "colemak",
  "type": "colemak",
  "metadata": {
    "display_name": "Colemak",
    "author": "Shai Coleman (2006)",
    "description": "Modern Dvorak alternative that keeps ZXCV near QWERTY positions for undo/cut/copy/paste.",
    "version": "1.0",
    "tags": ["english", "alt"]
  },
  "layout": {
    "upper": {
      "1st": ["~", "!", "@", "#", "$", "%", "^", "&", "*", "(", ")", "_", "+", "|"],
      "2nd": ["Q", "W", "F", "P", "G", "J", "L", "U", "Y", ":", "{", " }"],
      "3nd": ["A", "R", "S", "T", "D", "H", "N", "E", "I", "O", "\""],
      "4th": ["Z", "X", "C", "V", "B", "K", "M", "<", ">", "?"]
    },
    "lower": {
      "1st": ["`", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "-", "=", "\\"],
      "2nd": ["q", "w", "f", "p", "g", "j", "l", "u", "y", ";", "[", "]"],
      "3nd": ["a", "r", "s", "t", "d", "h", "n", "e", "i", "o", "'"],
      "4th": ["z", "x", "c", "v", "b", "k", "m", ",", ".", "/"]
    }
  }
}
