  "metadata": {
    "display_name": {
      "ko": "안마태 자판 (2003)",
      "en": "Ahnmatae Keyboard (2003)"
    },
    "author": "안마태·김진형 (2003)",
    "description": {
      "ko": "안마태 신부와 KAIST 김진형 교수가 2003년 발표한 모아치기 세벌식 자판. cho/jung/jong 영역이 고정되며, 양방향 자모 결합으로 겹받침 순서에 유연성을 준다. 원본의 옛한글 자리(W·T·G·J·B·N upper)는 한글 조판 기호로 대체.",
      "en": "Three-beol moachigi keyboard developed by Father Ahnmatae and Prof. Kim Jin-hyung of KAIST, published 2003. Fixed cho/jung/jong regions; bidirectional jamo combine for flexible jongseong order. Original archaic-jamo positions (W/T/G/J/B/N upper) replaced with Korean typography symbols."
    },
    "version": "2.0",
    "tags": [
      "korean",
      "anmatae",
      "moachigi",
      "3bul",
      "phonetic"
    ]
  },
  "supports_moachigi": true,
  "layout": {
    "upper": {
      "1st": ["~", "!", "@", "#", "$", "%", "^", "&", "*", "(", ")", "_", "+", "|"],
      "2nd": ["ㅁ", "'", "ㄴ", "ㄹ", "…", ";", "'", "/", "[", "]", "{", "}"],
      "3rd": ["ㅂ", "ㅈ", "ㄷ", "ㄱ", "“", "ㅓ", "·", "ㅣ", "ㅗ", "ㅜ", "\""],
      "4th": ["ᆽ", "ᆮ", "ᆸ", "ᆨ", "”", "‘", "ᆫ", "ᆷ", "ᆯ", "?"]
    },
    "lower": {
      "1st": ["`", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "-", "=", "\\"],
      "2nd": ["ㅁ", "ㅅ", "ㄴ", "ㄹ", "ㅎ", "ㅕ", "ㅑ", "ㅡ", "ㅛ", "ㅠ", "[", "]"],
      "3rd": ["ㅂ", "ㅈ", "ㄷ", "ㄱ", "ㅇ", "ㅓ", "ㅏ", "ㅣ", "ㅗ", "ㅜ", "'"],
