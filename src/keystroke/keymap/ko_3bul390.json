{
  "schema_version": 1,
  "language": "korean",
  "name": "3bul390",
  "type": "3bul",
  "metadata": {
    "display_name": "세벌식 390",
    "author": "공병우 (1990)",
    "description": "세벌식 최종 이전의 390 자판. 숫자열 일부가 받침 대신 초성/중성 확장으로 재배치됨. 일부 원본 규약(9/・-이중모음 첫 모음 전용, / 문맥 의존)은 v1 스키마 범위 밖으로 6단계 엔진 재설계에서 다룸.",
    "version": "1.0",
    "tags": ["korean", "3bul", "standard"]
  },
  "layout": {
    "upper": {
      "1st": ["~", "ᆽ", "@", "#", "$", "%", "^", "&", "*", "(", ")", "_", "+", "|"],
      "2nd": ["ᇁ", "ᇀ", "ᆿ", "ㅒ", ";", "<", "7", "8", "9", ">", "{", "}"],
      "3nd": ["ᆮ", "ᆬ", "ᆰ", "ᆩ", "/", "'", "4", "5", "6", ":", "\""],
      "4th": ["ᆾ", "ᆹ", "ᆱ", "ᆶ", "!", "0", "1", "2", "3", "?"]
    },
    "lower": {
      "1st": ["`", "ᇂ", "ᆻ", "ᆸ", "ㅛ", "ㅠ", "ㅑ", "ㅖ", "ㅢ", "ㅜ", "ㅋ", "-", "=", "\\"],
      "2nd": ["ᆺ", "ᆯ", "ㅕ", "ㅐ", "ㅓ", "ㄹ", "ㄷ", "ㅁ", "ㅊ", "ㅍ", "[", "]"],
      "3nd": ["ᆼ", "ᆫ", "ㅣ", "ㅏ", "ㅡ", "ㄴ", "ㅇ", "ㄱ", "ㅈ", "ㅂ", "ㅌ"],
      "4th": ["ᆷ", "ᆨ", "ㅔ", "ㅗ", "ㅜ", "ㅅ", "ㅎ", ",", ".", "ㅗ"]
    }
  },
  "combinations": {
    "cho": [
      { "first": "ㄱ", "second": "ㄱ", "result": "ㄲ" },
      { "first": "ㄷ", "second": "ㄷ", "result": "ㄸ" },
      { "first": "ㅂ", "second": "ㅂ", "result": "ㅃ" },
      { "first": "ㅅ", "second": "ㅅ", "result": "ㅆ" },
      { "first": "ㅈ", "second": "ㅈ", "result": "ㅉ" }
    ],
    "jung": [
      { "first": "ㅗ", "second": "ㅏ", "result": "ㅘ" },
      { "first": "ㅗ", "second": "ㅐ", "result": "ㅙ" },
      { "first": "ㅗ", "second": "ㅣ", "result": "ㅚ" },
      { "first": "ㅜ", "second": "ㅓ", "result": "ㅝ" },
      { "first": "ㅜ", "second": "ㅔ", "result": "ㅞ" },
      { "first": "ㅜ", "second": "ㅣ", "result": "ㅟ" },
      { "first": "ㅡ", "second": "ㅣ", "result": "ㅢ" }
    ],
    "jong": [
      { "first": "ᆨ", "second": "ᆨ", "result": "ᆩ" },
      { "first": "ᆨ", "second": "ᆺ", "result": "ᆪ" },
      { "first": "ᆫ", "second": "ᆽ", "result": "ᆬ" },
      { "first": "ᆫ", "second": "ᇂ", "result": "ᆭ" },
      { "first": "ᆯ", "second": "ᆨ", "result": "ᆰ" },
      { "first": "ᆯ", "second": "ᆷ", "result": "ᆱ" },
      { "first": "ᆯ", "second": "ᆸ", "result": "ᆲ" },
      { "first": "ᆯ", "second": "ᆺ", "result": "ᆳ" },
      { "first": "ᆯ", "second": "ᇀ", "result": "ᆴ" },
      { "first": "ᆯ", "second": "ᇁ", "result": "ᆵ" },
      { "first": "ᆯ", "second": "ᇂ", "result": "ᆶ" },
      { "first": "ᆸ", "second": "ᆺ", "result": "ᆹ" },
      { "first": "ᆺ", "second": "ᆺ", "result": "ᆻ" }
    ]
  },
  "rule_sets": {
    "sun_arae_batchim": {
      "active": false,
      "description": "순아래받침 규칙 (docs/research/순아래받침_규칙.md). 기본 종성 8개(ㄱㄴㄹㅁㅂㅅㅇㅎ)만 사용하는 사용자용 변종 키맵과 짝으로 사용. 기본 390 layout에는 겹받침이 직접 배치되어 있으므로 active=false.",
      "combinations": [
        { "first": "ᆫ", "second": "ᆫ", "result": "ᆮ" },
        { "first": "ᆫ", "second": "ᆺ", "result": "ᆽ" },
        { "first": "ᆨ", "second": "ᇂ", "result": "ᆿ" },
        { "first": "ᆸ", "second": "ᇂ", "result": "ᇁ" },
        { "first": "ᆮ", "second": "ᇂ", "result": "ᇀ" },
        { "first": "ᆽ", "second": "ᇂ", "result": "ᆾ" },
        { "first": "ᆭ", "second": "ᆺ", "result": "ᆬ" },
        { "first": "ᆶ", "second": "ᆫ", "result": "ᆴ" },
        { "first": "ᆶ", "second": "ᆸ", "result": "ᆵ" }
      ]
    },
    "sun_arae_moeum": {
      "active": false,
      "description": "순아래모음 규칙. ㅒ,ㅖ를 입력 시, 시프트를 안쓰도록, 혹은 타건 흐름을 유지하도록 ㅒ,ㅖ를 조합으로 입력. 기본 390 layout에는 ㅒ,ㅖ가 직접 배치되어 있으므로 active=false.",
      "combinations": [
        { "first": "ㅑ", "second": "ㅣ", "result": "ㅒ" },
        { "first": "ㅕ", "second": "ㅣ", "result": "ㅖ" }
      ]
    }
  }
}
