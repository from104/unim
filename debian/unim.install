# ─────────────────────────────────────────────────────────────────────────────
# UNIM Core Package
# ─────────────────────────────────────────────────────────────────────────────

# Core library
debian/tmp/usr/lib/x86_64-linux-gnu/libunim_capi.so     usr/lib/x86_64-linux-gnu/

# Header file
debian/tmp/usr/include/unim.h                           usr/include/

# CLI tools and executables
debian/tmp/usr/bin/unim-cli                             usr/bin/
debian/tmp/usr/bin/unim-config                          usr/bin/
debian/tmp/usr/bin/unim-indicator                       usr/bin/

# Daemons and servers
debian/tmp/usr/libexec/unim-daemon                      usr/libexec/
debian/tmp/usr/libexec/unim-xim                         usr/libexec/
debian/tmp/usr/libexec/unim-wayland                     usr/libexec/

# im-config integration
debian/tmp/usr/share/im-config/data/25_unim.conf        usr/share/im-config/data/
debian/tmp/usr/share/im-config/data/25_unim.rc          usr/share/im-config/data/

# Icons
debian/tmp/usr/share/icons/hicolor/scalable/apps/unim-hangul.svg   usr/share/icons/hicolor/scalable/apps/
debian/tmp/usr/share/icons/hicolor/scalable/apps/unim-latin.svg    usr/share/icons/hicolor/scalable/apps/

# Autostart
debian/tmp/etc/xdg/autostart/unim-indicator.desktop     etc/xdg/autostart/
