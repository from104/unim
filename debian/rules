#!/usr/bin/make -f
# ─────────────────────────────────────────────────────────────────────────────
# UNIM Debian Package Build Rules
# Uses the project Makefile for build and install
# ─────────────────────────────────────────────────────────────────────────────

export DH_VERBOSE = 1
export LC_ALL = C.UTF-8

# Multi-arch support
export DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

# Rust toolchain — prefer rustup if available, fall back to system cargo
REAL_HOME := $(shell getent passwd $$(id -u) | cut -d: -f6)
CARGO_BIN := $(REAL_HOME)/.cargo/bin
ifneq ($(wildcard $(CARGO_BIN)/cargo),)
    export RUSTUP_TOOLCHAIN = stable
endif

# Clean PATH: Remove Anaconda/Conda to ensure system Qt is used
CLEAN_PATH := $(shell echo "$$PATH" | tr ':' '\n' | grep -v -E '(anaconda|conda|miniconda)' | tr '\n' ':' | sed 's/:$$//')
export PATH := $(CARGO_BIN):$(CLEAN_PATH)

# Ensure system libraries are used (not Anaconda)
unexport LD_LIBRARY_PATH
unexport LIBRARY_PATH
unexport CPATH
unexport C_INCLUDE_PATH
unexport CPLUS_INCLUDE_PATH
unexport CMAKE_PREFIX_PATH
unexport QT_PLUGIN_PATH
unexport CONDA_PREFIX
unexport CONDA_DEFAULT_ENV

# Makefile variables for Debian packaging
PREFIX ?= /usr
DESTDIR ?= $(CURDIR)/debian/tmp

%:
	dh $@

# ─────────────────────────────────────────────────────────────────────────────
# Build
# ─────────────────────────────────────────────────────────────────────────────

override_dh_auto_build:
	$(MAKE) build
	$(MAKE) gnome-extension

# ─────────────────────────────────────────────────────────────────────────────
# Install
# ─────────────────────────────────────────────────────────────────────────────

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(DESTDIR) PREFIX=$(PREFIX)
	# Strip residual RUNPATH entries from .so files (CMake INSTALL_RPATH "" should
	# already handle this; chrpath -d acts as a defence in depth so the package
	# stays lintian-clean even if upstream CMake macros re-introduce build-tree
	# RPATH entries).
	find $(DESTDIR) -type f -name '*.so' -exec chrpath -d {} + 2>/dev/null || true
	find $(DESTDIR) -type f -name '*.so.*' -exec chrpath -d {} + 2>/dev/null || true

# ─────────────────────────────────────────────────────────────────────────────
# Skip tests (speed up packaging)
# ─────────────────────────────────────────────────────────────────────────────

override_dh_auto_test:
	:

# ─────────────────────────────────────────────────────────────────────────────
# Clean
# ─────────────────────────────────────────────────────────────────────────────

override_dh_auto_clean:
	$(MAKE) clean-all || true
