#!/usr/bin/make -f
# ─────────────────────────────────────────────────────────────────────────────
# UNIM Debian Package Build Rules
# Uses the project Makefile for build and install
# ─────────────────────────────────────────────────────────────────────────────

export DH_VERBOSE = 1
export LC_ALL = C.UTF-8

# Multi-arch support
export DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

# Rust toolchain
export RUSTUP_TOOLCHAIN = stable
export HOME = /home/from104

# Clean PATH: Remove Anaconda/Conda to ensure system Qt is used
# This prevents linking against Anaconda's Qt libraries
CLEAN_PATH := $(shell echo "$$PATH" | tr ':' '\n' | grep -v -E '(anaconda|conda|miniconda)' | tr '\n' ':' | sed 's/:$$//')
export PATH := $(HOME)/.cargo/bin:$(CLEAN_PATH)

# Ensure system libraries are used (not Anaconda)
unexport LD_LIBRARY_PATH
unexport LIBRARY_PATH
unexport CPATH
unexport C_INCLUDE_PATH
unexport CPLUS_INCLUDE_PATH
unexport CMAKE_PREFIX_PATH
unexport QT_PLUGIN_PATH
unexport CONDA_PREFIX
unexport CONDA_DEFAULT_ENV

# Makefile variables for Debian packaging
PREFIX ?= /usr
DESTDIR ?= $(CURDIR)/debian/tmp

%:
	dh $@

# ─────────────────────────────────────────────────────────────────────────────
# Build: Use Makefile's build targets
# ─────────────────────────────────────────────────────────────────────────────

override_dh_auto_build:
	# Full build using Makefile
	$(MAKE) build
	# Build GNOME extension assets
	$(MAKE) gnome-extension

# ─────────────────────────────────────────────────────────────────────────────
# Install: Use Makefile's install targets with DESTDIR
# ─────────────────────────────────────────────────────────────────────────────

override_dh_auto_install:
	# Install to staging directory using Makefile
	# REAL_LIBDIR and MULTIARCH will be automatically detected by Makefile
	$(MAKE) install DESTDIR=$(DESTDIR) PREFIX=$(PREFIX)
	
	# Install GNOME extension to staging directory
	install -d $(DESTDIR)/usr/share/gnome-shell/extensions/unim-typefix@from104.github.io
	cp -r unim-gnome-extension/* $(DESTDIR)/usr/share/gnome-shell/extensions/unim-typefix@from104.github.io/

# ─────────────────────────────────────────────────────────────────────────────
# Skip default test (speed up packaging)
# ─────────────────────────────────────────────────────────────────────────────

override_dh_auto_test:
	:

# ─────────────────────────────────────────────────────────────────────────────
# Clean: Use Makefile's clean target
# ─────────────────────────────────────────────────────────────────────────────

override_dh_auto_clean:
	$(MAKE) clean || true
