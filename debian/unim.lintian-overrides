# UNIM — lintian overrides (justified)
#
# All overrides below are static, deliberate, and reviewed. Remove them only
# if the underlying root cause changes.

# ─────────────────────────────────────────────────────────────────────────────
# embedded-library libyaml
# ─────────────────────────────────────────────────────────────────────────────
# UNIM is a Rust workspace. YAML deserialisation is provided by the crate
# `unsafe-libyaml` (transitively via `serde_yaml`), which is a pure-Rust
# rewrite of the libyaml C library — its symbols match the upstream C API
# closely enough for lintian's heuristic to flag every Rust binary that
# embeds it. There is no system libyaml.so dependency: nothing is dynamically
# linked, the rewrite lives entirely inside the static Rust artefacts, and
# Rust crates are not unbundled by Debian policy. Disabling these overrides
# would require either dropping YAML support outright or vendoring a C
# libyaml shim, neither of which is acceptable.
unim: embedded-library libyaml [usr/bin/unim-cli]
unim: embedded-library libyaml [usr/bin/unim-gui-gtk]
unim: embedded-library libyaml [usr/lib/*/libunim_capi.so.*]
unim: embedded-library libyaml [usr/libexec/unim-daemon]
unim: embedded-library libyaml [usr/libexec/unim-wayland]
unim: embedded-library libyaml [usr/libexec/unim-xim]

# ─────────────────────────────────────────────────────────────────────────────
# package-name-doesnt-match-sonames libunim-capi0
# link-to-shared-library-in-wrong-package
# ─────────────────────────────────────────────────────────────────────────────
# UNIM ships as a single self-contained binary package by deliberate design
# (see docs/plans/DEBIAN_PACKAGING_REDESIGN.md §2.3 — "minimise package
# count, two packages total"). libunim_capi is an internal stable C-API
# consumed only by the GTK/Qt IM modules and a handful of tooling shipped
# in the same package; there are no external reverse-dependencies and no
# planned -dev split. The unversioned `.so` link is kept so that locally
# built helpers and the gtk-common test apps can resolve the library by
# its base name without an ldconfig regeneration step.
unim: package-name-doesnt-match-sonames libunim-capi0
unim: link-to-shared-library-in-wrong-package usr/lib/*/libunim_capi.so.0.1.0 [usr/lib/*/libunim_capi.so]

# ─────────────────────────────────────────────────────────────────────────────
# initial-upload-closes-no-bugs
# ─────────────────────────────────────────────────────────────────────────────
# This is genuinely the first upload. There is no Debian BTS bug to close,
# and no upstream issue tracker tag is appropriate at this point.
unim: initial-upload-closes-no-bugs *
