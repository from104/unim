# ─────────────────────────────────────────────────────────────────────────────
# UNIM GTK Package (GTK3/GTK4 IM Modules + Settings)
# ─────────────────────────────────────────────────────────────────────────────

# GTK3 IM Module
debian/tmp/usr/lib/*/gtk-3.0/3.0.0/immodules/libim-unim.so        usr/lib/*/gtk-3.0/3.0.0/immodules/

# GTK4 IM Module
debian/tmp/usr/lib/*/gtk-4.0/4.0.0/immodules/libim-unim-gtk4.so   usr/lib/*/gtk-4.0/4.0.0/immodules/

# GTK Settings Tool
debian/tmp/usr/bin/unim-gtk-settings                                              usr/bin/
