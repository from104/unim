#!/bin/sh
set -e

case "$1" in
    remove|purge)
        # Update GTK3 IM modules cache
        if command -v gtk-query-immodules-3.0 >/dev/null 2>&1; then
            gtk-query-immodules-3.0 --update-cache || true
        fi
        # GTK4 discovers IM modules by directory scanning; no cache update needed
        ;;
esac

#DEBHELPER#

exit 0
