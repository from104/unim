# ─────────────────────────────────────────────────────────────────────────────
# unim-settings — cross-platform Slint settings app + first-run wizard
# Windows 빌드와 코드베이스를 공유하는 Slint(winit + Skia) 설정앱.
# --first-run/--whats-new 마법사와 로그인당 autostart 게이트(--first-run-if-needed)를 소유.
# ─────────────────────────────────────────────────────────────────────────────

# Slint settings binary
debian/tmp/usr/bin/unim-settings

# Application launcher entry (NoDisplay — 메뉴 중복 차단, StartupWMClass 로 창 연계)
debian/tmp/usr/share/applications/io.github.from104.unim.SettingsSlint.desktop

# Per-login autostart — 첫 로그인 시 마법사 1회 기동(--first-run-if-needed 게이트)
debian/tmp/etc/xdg/autostart/io.github.from104.unim.FirstRun.desktop

# Icon (동일 아트웍을 SettingsSlint app-id 로 복제 — unim-desktop 미설치 환경에서도 보장)
debian/tmp/usr/share/icons/hicolor/scalable/apps/io.github.from104.unim.SettingsSlint.svg

# Manual page
debian/tmp/usr/share/man/man1/unim-settings.1
