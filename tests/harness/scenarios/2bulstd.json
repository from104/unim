[
  {
    "name": "basic-compose-2bul",
    "desc": "두벌식 초성·중성·종성 조합과 space 확정",
    "layout": "ko_2bulstd",
    "korean": true,
    "field": "core.plain",
    "steps": [
      { "key": "g",     "expect": { "preedit": "ㅎ", "committed": "" } },
      { "key": "k",     "expect": { "preedit": "하", "committed": "" } },
      { "key": "s",     "expect": { "preedit": "한", "committed": "" } },
      { "key": "space", "expect": { "preedit": "", "committed": "한 " } }
    ]
  },
  {
    "name": "commit-then-preedit-2bul",
    "desc": "두벌식에서도 확정 직후 다음 글자가 즉시 보이는가",
    "layout": "ko_2bulstd",
    "korean": true,
    "field": "core.plain",
    "steps": [
      { "keys": ["g", "k", "s"], "expect": { "preedit": "한" } },
      { "key": "r", "expect": { "preedit": "ㄱ", "committed": "한",
                                "rendered": "한ㄱ" } },
      { "key": "space", "expect": { "preedit": "", "committed": "한ㄱ " } }
    ]
  },
  {
    "name": "click-commit-2bul",
    "desc": "두벌식 조합 중 다른 필드 클릭 시 원래 자리에 확정되는가",
    "layout": "ko_2bulstd",
    "korean": true,
    "field": "core.plain",
    "steps": [
      { "keys": ["g", "k", "s"], "expect": { "preedit": "한" } },
      { "click": "core.plain2", "field": "core.plain",
        "expect": { "preedit": "", "committed": "한" } },
      { "wait": 300, "field": "core.plain2", "expect": { "rendered": "" } }
    ]
  },
  {
    "name": "atf-forward-plain",
    "desc": "대조군 — 일반 칸·영문 모드에서 두벌식 \"대한민\" 로마자 오타(eogksals)를 치면 AutoTypeFix 순방향이 한글로 교정하는가 (password-no-atf 가 ATF 미작동으로 거저 통과하지 않음을 보장, L2 hw_case6 과 같은 입력)",
    "layout": "ko_2bulstd",
    "korean": false,
    "field": "core.plain",
    "notify": {
      "desc": "NOTIFY_SPEC §6 P2 — 교정 알림이 정확히 1회, 가림 문구(입력 텍스트 미포함)로 mock fdo 에 도달",
      "language": "ko",
      "forbid": ["eogksals", "대한민"],
      "expect": { "*": { "total": 1, "bodies": { "자동 교정됨 (영→한)": 1 } } }
    },
    "steps": [
      { "keys": ["e", "o", "g", "k", "s", "a", "l", "s"],
        "expect": { "rendered": "대한민" } },
      { "key": "space", "expect": { "preedit": "", "committed": "대한민 " } }
    ]
  },
  {
    "name": "password-no-atf",
    "desc": "비밀번호 칸(purpose=Password)에서는 한글 모드여도 영문이 강제되고, atf-forward-plain 에서 교정되던 eogksals 가 그대로 남아 AutoTypeFix 가 일어나지 않는가, 일반 칸으로 옮기면 한글 모드가 복구되는가 (engine_worker.rs atf_active_for_field·surrounding.rs set_content_purpose)",
    "layout": "ko_2bulstd",
    "korean": true,
    "field": "core.password",
    "notify": {
      "desc": "NOTIFY_SPEC §6 P2 — GTK3/GTK4/Qt: 교정 알림 0건·password_enter 1건. XIM 은 목적 전달 불가라 password_enter 0건 — 그리고 이 시나리오는 한글 모드라 XIM 에서는 ATF 가 아니라 한글 조합이 일어나 교정 알림도 0건(가림 문구 정확 일치는 atf-forward-plain 이 XIM 에서 단언)",
      "language": "ko",
      "forbid": ["eogksals", "대한민"],
      "expect": {
        "*":   { "total": 1, "bodies": { "비밀번호 칸: 영문 고정, 자동 교정 꺼짐": 1 } },
        "xim": { "total": 0 }
      }
    },
    "known_fail": {
      "xim": "XIM 프로토콜에는 입력 목적(purpose)을 IM 서버에 전달할 수단이 없다 — 비밀번호 칸이 일반 칸으로 보여 한글이 조합된다(프로토콜 한계, 수정 불가)"
    },
    "steps": [
      { "keys": ["e", "o", "g", "k", "s", "a", "l", "s"],
        "expect": { "preedit": "", "committed": "eogksals" } },
      { "wait": 800, "expect": { "preedit": "", "committed": "eogksals",
                                 "rendered": "eogksals" } },
      { "click": "core.plain2", "field": "core.plain2",
        "expect": { "rendered": "" } },
      { "keys": ["g", "k", "s"], "expect": { "preedit": "한" } },
      { "key": "space", "expect": { "preedit": "", "committed": "한 " } },
      { "wait": 300, "field": "core.password",
        "expect": { "committed": "eogksals", "preedit": "" } }
    ]
  },
  {
    "name": "password-notify-refocus",
    "desc": "비밀번호 칸을 벗어났다 같은 칸으로 되돌아와도 password_enter 알림은 1회뿐인가 (NOTIFY_SPEC §6 P2 — 컨텍스트당 1회 규칙, 알림 단언 전용 변형)",
    "layout": "ko_2bulstd",
    "korean": true,
    "field": "core.password",
    "skip_apps": {
      "xim": "XIM 은 입력 목적을 전달할 수 없어 비밀번호 칸이 일반 칸으로 보인다 — password-no-atf 가 알림 문구로 판정"
    },
    "notify": {
      "language": "ko",
      "forbid": ["eogksals"],
      "expect": { "*": { "total": 1, "bodies": { "비밀번호 칸: 영문 고정, 자동 교정 꺼짐": 1 } } }
    },
    "steps": [
      { "keys": ["e", "o", "g", "k", "s", "a", "l", "s"],
        "expect": { "preedit": "", "committed": "eogksals" } },
      { "click": "core.plain2", "field": "core.plain2",
        "expect": { "rendered": "" } },
      { "click": "core.password", "field": "core.password",
        "expect": { "committed": "eogksals", "preedit": "" } },
      { "wait": 600, "field": "core.password",
        "expect": { "committed": "eogksals" } }
    ]
  }
]
