[
  {
    "name": "basic-compose",
    "desc": "초성·중성·종성이 순서대로 조합되고 space 에서 확정되는가",
    "layout": "ko_3bul390",
    "korean": true,
    "field": "core.plain",
    "steps": [
      { "key": "m",     "expect": { "preedit": "ㅎ", "committed": "" } },
      { "key": "f",     "expect": { "preedit": "하", "committed": "" } },
      { "key": "s",     "expect": { "preedit": "한", "committed": "" } },
      { "key": "space", "expect": { "preedit": "", "committed": "한 ",
                                    "rendered": "한 " } }
    ]
  },
  {
    "name": "commit-then-preedit",
    "desc": "확정 직후 다음 글자가 같은 키에서 즉시 화면에 보이는가 (2026-08-07 XIM 회귀)",
    "layout": "ko_3bul390",
    "korean": true,
    "field": "core.plain",
    "steps": [
      { "key": "y",     "expect": { "preedit": "ㄹ", "committed": "",
                                    "rendered": "ㄹ" } },
      { "key": "y",     "expect": { "preedit": "ㄹ", "committed": "ㄹ",
                                    "rendered": "ㄹㄹ" } },
      { "key": "y",     "expect": { "preedit": "ㄹ", "committed": "ㄹㄹ",
                                    "rendered": "ㄹㄹㄹ" } },
      { "key": "space", "expect": { "preedit": "", "committed": "ㄹㄹㄹ ",
                                    "rendered": "ㄹㄹㄹ " } }
    ]
  },
  {
    "name": "click-commit",
    "desc": "조합 중 다른 필드를 클릭하면 원래 자리에 확정되고 클릭한 곳은 비어 있는가 (2026-08-06 회귀)",
    "layout": "ko_3bul390",
    "korean": true,
    "field": "core.plain",
    "steps": [
      { "keys": ["m", "f", "s"], "expect": { "preedit": "한" } },
      { "click": "core.plain2", "field": "core.plain",
        "expect": { "preedit": "", "committed": "한", "rendered": "한" } },
      { "wait": 300, "field": "core.plain2",
        "expect": { "committed": "", "preedit": "", "rendered": "" } }
    ]
  },
  {
    "name": "focus-switch",
    "desc": "Tab 으로 필드를 옮기면 조합이 원래 필드에 확정되는가",
    "layout": "ko_3bul390",
    "korean": true,
    "field": "core.plain",
    "steps": [
      { "keys": ["m", "f", "s"], "expect": { "preedit": "한" } },
      { "key": "Tab", "field": "core.plain",
        "expect": { "preedit": "", "committed": "한" } },
      { "wait": 300, "field": "core.plain2", "expect": { "rendered": "" } }
    ]
  },
  {
    "name": "password-compose",
    "desc": "비밀번호 칸(시험 앱이 IM 에 purpose=Password 를 알림)에서는 한글 모드여도 영문이 강제되어 한글 키가 라틴 문자 그대로 확정되고 preedit 이 없는가, 일반 칸으로 돌아가면 한글 모드가 복구되는가 (press_key.rs Password/PIN 영문 강제·surrounding.rs set_content_purpose)",
    "layout": "ko_3bul390",
    "korean": true,
    "field": "core.password",
    "known_fail": {
      "xim": "XIM 프로토콜에는 입력 목적(purpose)을 IM 서버에 전달할 수단이 없다 — 비밀번호 칸이 일반 칸으로 보여 한글이 조합된다(프로토콜 한계, 수정 불가)"
    },
    "steps": [
      { "key": "m", "expect": { "preedit": "", "committed": "m" } },
      { "keys": ["f", "s"], "expect": { "preedit": "", "committed": "mfs" } },
      { "key": "space", "expect": { "preedit": "", "committed": "mfs ",
                                    "rendered": "mfs " } },
      { "click": "core.plain", "field": "core.plain",
        "expect": { "rendered": "" } },
      { "keys": ["m", "f", "s"], "expect": { "preedit": "한" } },
      { "wait": 300, "field": "core.password",
        "expect": { "committed": "mfs ", "preedit": "" } }
    ]
  },
  {
    "name": "backspace-decompose",
    "desc": "조합 중 백스페이스가 낱자 단위로 분해하는가",
    "layout": "ko_3bul390",
    "korean": true,
    "field": "core.plain",
    "steps": [
      { "keys": ["m", "f", "s"], "expect": { "preedit": "한" } },
      { "key": "BackSpace", "expect": { "preedit": "하" } },
      { "key": "BackSpace", "expect": { "preedit": "ㅎ" } },
      { "key": "BackSpace", "expect": { "preedit": "", "committed": "" } }
    ]
  },
  {
    "name": "mode-toggle-flush",
    "desc": "조합 중 한/영 키를 누르면 조합이 확정되고 preedit 이 비는가",
    "layout": "ko_3bul390",
    "korean": true,
    "field": "core.plain",
    "steps": [
      { "keys": ["m", "f", "s"], "expect": { "preedit": "한" } },
      { "key": "Hangul", "expect": { "preedit": "", "committed": "한" } },
      { "keys": ["a", "b"], "expect": { "committed": "한ab" } }
    ]
  },
  {
    "name": "multiline-compose",
    "desc": "여러 줄 필드에서 조합과 줄바꿈이 함께 동작하는가",
    "layout": "ko_3bul390",
    "korean": true,
    "field": "core.multiline",
    "steps": [
      { "keys": ["m", "f", "s"], "expect": { "preedit": "한" } },
      { "key": "Return", "expect": { "preedit": "", "committed": "한\n" } },
      { "keys": ["k", "g", "w"], "expect": { "preedit": "글" } },
      { "key": "space", "expect": { "committed": "한\n글 " } }
    ]
  }
]
