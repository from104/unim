# start UNIM
# vim: set sts=4 expandtab:

# Note: unim-daemon is started via DBus auto-activation
# (see /usr/share/dbus-1/services/org.atit.unim.InputMethod.service)
# No explicit daemon startup is needed here.

if [ "$IM_CONFIG_PHASE" = 1 ]; then
    GTK_IM_MODULE=unim
    QT_IM_MODULE=unim

    if [ "$XDG_SESSION_TYPE" = "x11" ] || [ -n "$DISPLAY" ]; then
        XMODIFIERS=@im=unim
        CLUTTER_IM_MODULE=xim
    fi
fi
