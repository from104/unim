/* UNIM Qt6 Settings - Premium Modern Style (Adwaita-like) */

/* 메인 윈도우 */
QDialog {
    background-color: #1e1e1e; /* 다크 배경 */
    color: #e0e0e0;
}

/* 섹션 타이틀 라벨 */
QLabel#sectionTitle {
    color: #3584e4; /* Adwaita Blue */
    font-weight: bold;
    font-size: 18px;
    margin-top: 20px;
    margin-bottom: 8px;
    margin-left: 4px;
}

/* 설정 카드 역할을 하는 프레임 */
QFrame#settingsCard {
    background-color: #2b2b2b; /* 카드 배경 */
    border-radius: 12px;
    padding: 2px;
}

/* 설정 행 정렬을 위한 컨테이너 */
QWidget#settingsRow {
    min-height: 48px;
}

/* 라벨 기본 스타일 */
QLabel {
    font-size: 14px;
}

/* 콤보박스 - 현대적 디자인 */
QComboBox {
    padding: 6px 12px;
    border: 1px solid #444;
    border-radius: 6px;
    background-color: #333;
    color: #fff;
    min-width: 180px;
    min-height: 28px;
}

QComboBox:hover {
    border-color: #3584e4;
    background-color: #3d3d3d;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none; /* 필요시 아이콘 추가 가능 */
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #bbb;
    margin-right: 8px;
}

/* 스위치 (QCheckBox 기반) */
QCheckBox::indicator {
    width: 44px;
    height: 24px;
    border-radius: 12px;
}

QCheckBox::indicator:unchecked {
    background-color: #444;
}

QCheckBox::indicator:unchecked:hover {
    background-color: #555;
}

QCheckBox::indicator:checked {
    background-color: #3584e4;
}

/* 슬라이더 */
QSlider::groove:horizontal {
    height: 4px;
    background: #444;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #fff;
    border: 1px solid #888;
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border-radius: 9px;
}

QSlider::sub-page:horizontal {
    background: #3584e4;
    border-radius: 2px;
}

/* 임계값 라벨 */
QLabel#thresholdLabel {
    font-family: monospace;
    font-weight: bold;
    min-width: 40px;
    color: #bbb;
}
