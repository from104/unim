<?xml version="1.0" encoding="UTF-8"?>
<!--
  UNIM Korean IME — Windows MSI installer (WiX Toolset 3.x).

  Build (Windows runner, GitHub Actions or local):
    candle.exe -arch x64 -dWIN_OUT_DIR=path\to\release -out unim.wixobj installer\wix\unim.wxs
    light.exe   -ext WixUIExtension -out dist\unim-x64.msi unim.wixobj

  Or via cargo-wix:
    cargo wix --target x86_64-pc-windows-msvc --no-build -p unim-tsf

  TSF registration: dual track.
    (1) Static registry keys below mirror what unim-tsf/src/register.rs writes.
    (2) <File SelfRegCost="1"> invokes DllRegisterServer for the COM-API
        registration that requires live ITfInputProcessorProfiles calls.

  GUID source of truth: unim-tsf/src/globals.rs. Run
  `bash installer/wix/gen-guids.sh` whenever globals.rs changes.
-->
<?include generated/guids.wxi ?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="UNIM Korean IME"
           Language="1033"
           Version="$(var.UnimVersion)"
           Manufacturer="atit.org"
           UpgradeCode="4F1A2B3C-5D6E-7F80-9A1B-2C3D4E5F6A7B">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="UNIM Korean Input Method (Hangul + Hanja)"
             Comments="https://github.com/from104/unim" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of UNIM is already installed." />

    <Media Id="1" Cabinet="unim.cab" EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="UNIM">

          <!-- Standalone GUI executable (egui tray + settings). -->
          <Component Id="UnimWindowsExe"
                     Guid="5A6B7C8D-9E0F-1A2B-3C4D-5E6F7A8B9C0D"
                     Win64="yes">
            <File Id="unim_windows.exe"
                  Name="unim-windows.exe"
                  Source="$(var.WIN_OUT_DIR)\unim-windows.exe"
                  KeyPath="yes" />
          </Component>

          <!--
            TSF IME DLL.
            SelfRegCost="1" enables MSI's built-in self-registration:
            DllRegisterServer is invoked at InstallFinalize, which calls
            register_server() in unim-tsf to register the TSF profile and
            categories via ITfInputProcessorProfileMgr / ITfCategoryMgr
            (the COM API path Microsoft documents as the canonical method).

            Static registry entries below provide the COM CLSID / TIP entry /
            language profile / category keys so the IME survives a profile
            corruption or a sandboxed install where DllRegisterServer might
            silently fail. Both paths are idempotent.
          -->
          <Component Id="UnimTsfDll"
                     Guid="6B7C8D9E-0F1A-2B3C-4D5E-6F7A8B9C0D1E"
                     Win64="yes">
            <File Id="unim_tsf.dll"
                  Name="unim_tsf.dll"
                  Source="$(var.WIN_OUT_DIR)\unim_tsf.dll"
                  SelfRegCost="1"
                  KeyPath="yes" />

            <!-- (1) COM CLSID — HKCR\CLSID\{CLSID} -->
            <RegistryKey Root="HKCR" Key="CLSID\$(var.UnimClsid)" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="UNIM Korean IME" />
            </RegistryKey>
            <RegistryKey Root="HKCR" Key="CLSID\$(var.UnimClsid)\InProcServer32" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="[#unim_tsf.dll]" />
              <RegistryValue Type="string" Name="ThreadingModel" Value="Apartment" />
            </RegistryKey>

            <!-- (2) TIP entry — HKLM\SOFTWARE\Microsoft\CTF\TIP\{CLSID} -->
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\CTF\TIP\$(var.UnimClsid)" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="" />
            </RegistryKey>

            <!-- (3) Language profile — HKLM\...\CTF\TIP\{CLSID}\LanguageProfile\0x00000412\{PROFILE_GUID} -->
            <RegistryKey Root="HKLM"
                         Key="SOFTWARE\Microsoft\CTF\TIP\$(var.UnimClsid)\LanguageProfile\$(var.UnimLangIdHexPadded)\$(var.UnimProfileGuid)"
                         ForceCreateOnInstall="yes"
                         ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Name="Description" Value="UNIM Korean IME" />
              <RegistryValue Type="integer" Name="Enable" Value="1" />
            </RegistryKey>

            <!--
              (4) TSF categories.
              Format (Microsoft SampleIME pattern):
                Category\Category\{CATEGORY_GUID}\{CLSID}     ← Category subkey is CLSID
                Category\Item\{CATEGORY_GUID}\{CLSID}         ← Item subkey is CLSID
              Previously this file used {CATEGORY_GUID}\{CATEGORY_GUID} (a
              copy-paste bug); that prevented OS-side TIP category discovery.
            -->

            <!-- TIP_KEYBOARD = {34745C63-B2F0-4784-8B67-5E12C8701A31} -->
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\CTF\TIP\$(var.UnimClsid)\Category\Category\{34745C63-B2F0-4784-8B67-5E12C8701A31}\$(var.UnimClsid)" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="" />
            </RegistryKey>
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\CTF\TIP\$(var.UnimClsid)\Category\Item\{34745C63-B2F0-4784-8B67-5E12C8701A31}\$(var.UnimClsid)" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="" />
            </RegistryKey>

            <!-- DISPLAYATTRIBUTEPROVIDER = {046B8C80-1647-40F7-9B21-B93B81AABC1B} -->
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\CTF\TIP\$(var.UnimClsid)\Category\Category\{046B8C80-1647-40F7-9B21-B93B81AABC1B}\$(var.UnimClsid)" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="" />
            </RegistryKey>
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\CTF\TIP\$(var.UnimClsid)\Category\Item\{046B8C80-1647-40F7-9B21-B93B81AABC1B}\$(var.UnimClsid)" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="" />
            </RegistryKey>

            <!-- TIPCAP_UIELEMENTENABLED = {78D0B53D-BBB0-44D5-9489-2A6BC9CB73BA} -->
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\CTF\TIP\$(var.UnimClsid)\Category\Category\{78D0B53D-BBB0-44D5-9489-2A6BC9CB73BA}\$(var.UnimClsid)" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="" />
            </RegistryKey>
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\CTF\TIP\$(var.UnimClsid)\Category\Item\{78D0B53D-BBB0-44D5-9489-2A6BC9CB73BA}\$(var.UnimClsid)" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="" />
            </RegistryKey>

            <!-- TIPCAP_IMMERSIVESUPPORT = {13A016DF-560B-46CD-947A-4C3AF1E0E35D} -->
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\CTF\TIP\$(var.UnimClsid)\Category\Category\{13A016DF-560B-46CD-947A-4C3AF1E0E35D}\$(var.UnimClsid)" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="" />
            </RegistryKey>
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\CTF\TIP\$(var.UnimClsid)\Category\Item\{13A016DF-560B-46CD-947A-4C3AF1E0E35D}\$(var.UnimClsid)" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="" />
            </RegistryKey>

            <!-- TIPCAP_SYSTRAYSUPPORT = {25504FB4-7BAB-4BC1-9C69-CF81890F0EF5} -->
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\CTF\TIP\$(var.UnimClsid)\Category\Category\{25504FB4-7BAB-4BC1-9C69-CF81890F0EF5}\$(var.UnimClsid)" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="" />
            </RegistryKey>
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\CTF\TIP\$(var.UnimClsid)\Category\Item\{25504FB4-7BAB-4BC1-9C69-CF81890F0EF5}\$(var.UnimClsid)" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
              <RegistryValue Type="string" Value="" />
            </RegistryKey>
          </Component>

          <!-- Fallback batch scripts in case an end user needs manual (un)register. -->
          <Component Id="RegisterScripts"
                     Guid="8D9E0F1A-2B3C-4D5E-6F7A-8B9C0D1E2F30"
                     Win64="yes">
            <File Id="register_bat"
                  Name="register-tsf.bat"
                  Source="..\scripts\register-tsf.bat"
                  KeyPath="yes" />
            <File Id="unregister_bat"
                  Name="unregister-tsf.bat"
                  Source="..\scripts\unregister-tsf.bat" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="UNIM">
          <Component Id="StartMenuShortcuts"
                     Guid="7C8D9E0F-1A2B-3C4D-5E6F-7A8B9C0D1E2F">
            <Shortcut Id="UnimWindowsShortcut"
                      Name="UNIM Korean IME"
                      Description="UNIM Korean Input Method (standalone GUI)"
                      Target="[INSTALLDIR]unim-windows.exe"
                      WorkingDirectory="INSTALLDIR" />
            <Shortcut Id="UnimUninstallShortcut"
                      Name="Uninstall UNIM"
                      Description="Remove UNIM Korean IME"
                      Target="[System64Folder]msiexec.exe"
                      Arguments="/x [ProductCode]" />
            <RemoveFolder Id="ApplicationProgramsFolderRemove" On="uninstall" />
            <RegistryValue Root="HKCU"
                           Key="Software\atit.org\UNIM"
                           Name="installed"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Complete"
             Title="UNIM Korean IME"
             Description="Hangul + Hanja Korean input method for Windows (TSF + standalone GUI)"
             Display="expand"
             Level="1"
             ConfigurableDirectory="INSTALLDIR"
             AllowAdvertise="no"
             Absent="disallow">
      <ComponentRef Id="UnimWindowsExe" />
      <ComponentRef Id="UnimTsfDll" />
      <ComponentRef Id="RegisterScripts" />
      <ComponentRef Id="StartMenuShortcuts" />
    </Feature>

    <Property Id="ARPHELPLINK" Value="https://github.com/from104/unim" />
    <Property Id="ARPURLINFOABOUT" Value="https://atit.org" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="0" />

    <!--
      ARPPRODUCTICON: enable by placing installer/assets/unim.ico and uncommenting.
      <Property Id="ARPPRODUCTICON" Value="unim.ico" />
      <Icon Id="unim.ico" SourceFile="..\assets\unim.ico" />
    -->

  </Product>
</Wix>
